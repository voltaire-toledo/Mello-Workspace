@echo off
REM Example build script for building all components
REM Place this in worktrees/scripts/ after setup

echo ========================================
echo Building All Components
echo ========================================
echo.

REM Set paths
set ROOT_DIR=%~dp0..\..
set BUILD_OUT=%ROOT_DIR%\build-output
set MAKEFILES=%ROOT_DIR%\makefiles

echo [1/4] Building Main System...
REM Add your main system build commands here
REM Example: cd %ROOT_DIR%\worktrees\main-system && msbuild MainSystem.sln /p:Configuration=Release

echo [2/4] Building Plugins...
REM Add your plugins build commands here
REM Example: cd %ROOT_DIR%\worktrees\plugins && msbuild Plugins.sln /p:Configuration=Release

echo [3/4] Building Scripts...
echo Scripts are source files, no build needed.

echo [4/4] Building Resource DLLs...
cd %MAKEFILES%
nmake /f resources.mk
if errorlevel 1 (
    echo ERROR: Resource DLL build failed!
    exit /b 1
)

echo.
echo ========================================
echo Build Complete!
echo ========================================
echo.
echo Build outputs are in: %BUILD_OUT%
echo.

pause
