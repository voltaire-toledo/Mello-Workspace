# This repo is to only host what's necessary for the Mello-Workspace Dev Environment. 
# It should not contain any repos, build outputs, binaries, or other generated files.

# Worktree and feature branches (keep structure but not content)
repos/*
!repos/.gitkeep
releases/*
!releases/.gitkeep

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.obj
*.o
*.lib
*.a

# Resource files (compiled)
*.res
*.rc.o

# IDE and editor files
.vs/
.vscode/
*.suo
*.user
*.sln.docstates
*.swp
*.swo
*~

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary files
*.tmp
*.temp
*.log

# Package manager directories
node_modules/
packages/

